"role.charon.name" : "Charon"
"role.charon.short" : "Ch"
"role.charon.blurb" : "The Bleak Ferryman"
"teams.charon" : "Charon"
"end.charon" : "Charon Wins%EXTRA%"
"role.charon.doc" : "Charon is a neutral role who feigns death and builds Styx by traveling away from their corpse."
"role.charon.winCond" : "If Styx meets or exceeds the threshold when the game ends, Charon takes the win. Charon can qualify after dying."
"role.charon.ability.title" : "Abilities"
"role.charon.ability.main" : "While feigning death, gain Styx only for the distance that extends your record for this attempt. Styx drains in the task phase outside feigned death and stays fixed during meetings."
"role.charon.ability.pseudocide" : "<title>Feign Death</title>Leave a corpse and move as a ghost. You die permanently if a meeting starts, the active timer expires, or the corpse disappears."
"role.charon.ability.revive" : "<title>Revive</title>Revive at your current location within the map while your corpse remains."
"options.role.charon.detail" : "Build Styx by feigning death and take the win when the game ends."
"options.role.charon.cooldown" : "Feign Death Cooldown"
"options.role.charon.timeLimit" : "Feign Death Time Limit"
"options.role.charon.timeLimit.detail" : "Off applies the Feign Death Duration. On disables the countdown."
"options.role.charon.duration" : "Feign Death Duration"
"options.role.charon.hideFromVitals" : "Hide Feigned Death on Vitals"
"options.role.charon.required" : "Styx Required to Win"
"options.role.charon.surplus" : "Surplus Styx Capacity"
"options.role.charon.increase" : "Styx Gain Multiplier"
"options.role.charon.decrease" : "Styx Drain Multiplier"
